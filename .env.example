# SztuCode 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
SZTU_HOST=127.0.0.1
SZTU_PORT=7437

# ── Logging ───────────────────────────────────────────────────
SZTU_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
SZTU_LOG_FILE=~/.sztu/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
SZTU_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# SZTU_CONFIG=~/.sztu/config.toml

# ── LLM Provider ──────────────────────────────────────────────
# 选择 LLM 后端：anthropic（默认）或 openai（兼容 DeepSeek 等）
# SZTU_LLM_PROVIDER=anthropic

# ── Anthropic 配置 ────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# SZTU_LLM_DEFAULT_MODEL=<your-provider-model-id>
# SZTU_LLM_CONTEXT_WINDOW=128000

# ── OpenAI / DeepSeek 配置 ────────────────────────────────────
# SZTU_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com
# SZTU_LLM_DEFAULT_MODEL=<your-provider-model-id>

# DeepSeek V4 Pro（校园网）内置选项，仅在校园网或学校 VPN 下可用
# SZTU_CAMPUS_DEEPSEEK_API_KEY=<your-campus-api-key>

# ── opencode Zen 免费模型（免 key）────────────────────────────
# 端点 https://opencode.ai/zen/v1，无需 API key（不要设 OPENAI_API_KEY）
# 免费模型：deepseek-v4-flash-free / ling-3.0-flash-free / nemotron-3-ultra-free /
#           north-mini-code-free / longcat-2.0-free / mimo-v2.5-free / laguna-s-2.1-free
# SZTU_LLM_PROVIDER=openai
# SZTU_LLM_DEFAULT_MODEL=deepseek-v4-flash-free
# OPENAI_BASE_URL=https://opencode.ai/zen/v1

# ── Agent ─────────────────────────────────────────────────────
# SZTU_MAX_STEPS=20

# SZTU_COMPACT_THRESHOLD=0.85
# SZTU_COMPACT_TOOL_LIMIT=8000
# SZTU_COMPACT_TOOL_KEEP=4000
